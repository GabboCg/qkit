% Reading list for the qkit syllabus template.
%
% Every entry below is invented -- placeholder authors, titles and
% publishers -- so nothing here is mistaken for a real recommendation.
% Replace them wholesale with the readings for your course.
%
% Every entry is printed by the generated Recommended Readings section,
% because index.qmd sets the nocite key to a star. Drop that key if you
% would rather list only the works you actually cite in the body.
%
% Citations go through natbib/BibTeX, not citeproc, so TITLES MUST BE
% DOUBLE-BRACED -- see the entries below -- or BibTeX lowercases
% everything after the first word. The entry types here cover the shapes a
% syllabus usually needs: a textbook, a co-authored book, an edited-volume
% chapter, a journal article, and a piece of software.
%
% BibTeX has no comment syntax. It skips text between entries by scanning
% for the next at-sign, so an at-sign inside a percent-sign comment starts
% a bogus entry and BibTeX reports an error -- keep them out of this
% header.

@book{author2020textbook,
  title     = {{The Course Textbook: A Modern Introduction}},
  author    = {Author, Alice B.},
  edition   = {3},
  year      = {2020},
  publisher = {{Example Academic Press}},
  address   = {London}
}

@book{writer2019second,
  title     = {{A Second Recommended Textbook}},
  author    = {Writer, Charles D. and Scholar, Emma F.},
  year      = {2019},
  publisher = {{Placeholder University Press}},
  address   = {New York}
}

@incollection{contributor2021chapter,
  title     = {{A Chapter in an Edited Volume}},
  author    = {Contributor, Grace H.},
  booktitle = {{The Handbook of the Subject}},
  editor    = {Editor, Ivan J.},
  pages     = {101--140},
  year      = {2021},
  publisher = {{Example University Press}},
  address   = {Cambridge}
}

@article{researcher2018article,
  title   = {{An Illustrative Journal Article}},
  author  = {Researcher, Karen L. and Coauthor, Michael N.},
  journal = {{Journal of Example Studies}},
  volume  = {42},
  number  = {3},
  pages   = {195--228},
  year    = {2018}
}

@misc{toolmaker2024software,
  title        = {{Example Software: A Computing Environment for the Course}},
  author       = {{Example Software Project}},
  year         = {2024},
  howpublished = {Example Foundation, Anytown},
  note         = {\url{https://example.org/software}}
}
