% Titles are wrapped in double braces ({{...}}). The paper format uses
% natbib/BibTeX, and BibTeX applies change.case$ to the title field --
% without the extra braces "A VAR Model" would render as "a var model".
% Keep the double braces on every entry you add.

@article{example2025,
  title   = {{An Example Bibliography Entry}},
  author  = {Doe, Jane and Roe, John},
  journal = {Journal of Examples},
  year    = {2025},
  volume  = {1},
  pages   = {1--20}
}
